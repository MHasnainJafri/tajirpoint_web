# Copy to .env.local and fill in. NEXT_PUBLIC_* values are baked in at build
# time — rebuild after changing them.

# Canonical base URL of the site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API (plans, demo requests). Defaults to https://api.tajirpoint.com.
NEXT_PUBLIC_API_URL=

# ── Tracking (all optional) ───────────────────────────────────────────────
# Leave empty and no tracking script loads and no cookie banner is shown.
# When set, nothing loads until the visitor accepts the cookie banner.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta (Facebook / Instagram) Pixel ID, digits only
NEXT_PUBLIC_META_PIXEL_ID=
# Google Tag Manager container, e.g. GTM-XXXXXXX (only if GTM is used)
NEXT_PUBLIC_GTM_ID=

# ── Search engine + social ownership checks (all optional) ────────────────
# Each one renders a <meta> tag in every page head. Server-side, read at build
# time: redeploy after setting. Paste ONLY the token, not the whole tag.

# Google Search Console → Add property → URL prefix https://tajirpoint.com/
# → "HTML tag" method: the content="…" value.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → "Meta tag" method (msvalidate.01): the content value.
BING_SITE_VERIFICATION=
# Meta Business Manager → Brand safety → Domains → "Meta-tag verification"
# (facebook-domain-verification): the content value. Needed before Meta lets
# the Pixel's web events count for ads (Aggregated Event Measurement).
FACEBOOK_DOMAIN_VERIFICATION=
# Facebook App ID (digits) → fb:app_id, so Meta's Sharing Debugger stops warning
# and link-share insights are attributed to the app. Only if a Meta app exists.
FACEBOOK_APP_ID=

# ── Official social profiles (all optional) ───────────────────────────────
# Used for the Organization `sameAs` structured data (and `twitter:site`).
# Set ONLY profiles the business owns; unset ones are left out. Full https URLs.
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_LINKEDIN_URL=
SOCIAL_YOUTUBE_URL=
SOCIAL_TIKTOK_URL=
# X (Twitter) handle, e.g. @tajirpoint — only if the account exists.
SOCIAL_X_HANDLE=

# ── IndexNow (optional) ───────────────────────────────────────────────────
# Lets Bing and the other IndexNow engines recrawl changed pages within hours.
# Any 8–128 letters, digits or dashes, e.g. from `openssl rand -hex 16`. When
# set, the site serves the key file at /<key>.txt (redeploy after setting).
# After a deploy, ping the changed sitemap URLs with:
#   INDEXNOW_KEY=<same value> node scripts/indexnow-ping.mjs --dry-run
#   INDEXNOW_KEY=<same value> node scripts/indexnow-ping.mjs
INDEXNOW_KEY=

# ── Content-Security-Policy reports (optional) ────────────────────────────
# The site sends Content-Security-Policy-Report-Only (blocks nothing). Set an
# https endpoint that accepts CSP reports to collect them; unset = reports
# only show in the browser console.
CSP_REPORT_URI=
