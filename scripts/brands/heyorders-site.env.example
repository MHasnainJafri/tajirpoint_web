# The Hey Orders website (hey-orders.com): the same marketing site code as
# tajirpoint.com, built with Hey Orders' brand, hosts and market. Restaurants
# only, English only, UK. Nothing here is a secret.
#
# Copy to scripts/brands/heyorders-site.env (git-ignored by .env*), check
# every value marked CONFIRM, then:
#
#   bash scripts/build-brand-site.sh scripts/brands/heyorders-site.env
#
# The script copies BRAND_ASSETS_DIR into public/brands/heyorders/ for the
# build, runs `next build`, and fails if the output still names TajirPoint.
# Every variable is documented in src/lib/config/brand.ts.

# --- Brand ------------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME="Hey Orders"
NEXT_PUBLIC_BRAND_DESCRIPTION="Restaurant POS and back office in one: tables, kitchen display, waiter app, online orders, delivery and stock."
NEXT_PUBLIC_BRAND_TAGLINE="Orders, kitchen and delivery for restaurants."
# Stand-in art (documents/heyorders-brand, 2 Nov 2026) until Hey Orders sends
# its real files. Paths under public/brands/heyorders/ (copied in by the build
# script) or absolute https URLs.
NEXT_PUBLIC_BRAND_LOGO="/brands/heyorders/logo.png"
NEXT_PUBLIC_BRAND_LOGO_ON_DARK="/brands/heyorders/logo.png"
NEXT_PUBLIC_BRAND_FAVICON="/brands/heyorders/favicon.png"
NEXT_PUBLIC_BRAND_ICON="/brands/heyorders/icon-512.png"
NEXT_PUBLIC_BRAND_PRIMARY="#E4572E"
NEXT_PUBLIC_BRAND_INK="#111111"
# Copy that has to say more than another name (messages/brands/heyorders.en.json).
NEXT_PUBLIC_BRAND_MESSAGES="heyorders"

# --- Hosts --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://hey-orders.com"
NEXT_PUBLIC_BRAND_WEBSITE="https://hey-orders.com"
NEXT_PUBLIC_APP_URL="https://app.hey-orders.com"
# The backend origin; the site adds /api/v1 (= https://api.hey-orders.com/api/v1).
NEXT_PUBLIC_API_URL="https://api.hey-orders.com"
# Host of the add-on icons in the Hey Orders backend catalogue (MEDIA_DOMAIN). CONFIRM.
NEXT_PUBLIC_MEDIA_HOST="media.hey-orders.com"

# --- Company and contact --------------------------------------------------------
# CONFIRM: placeholder mailbox until Hey Orders names its own.
NEXT_PUBLIC_BRAND_EMAIL="support@hey-orders.com"
# No WhatsApp line: every WhatsApp link and sentence is left out.
NEXT_PUBLIC_BRAND_WHATSAPP=""
# CONFIRM: the registered company name and city (legal pages, structured data).
NEXT_PUBLIC_BRAND_LEGAL_NAME="Hey Orders"
NEXT_PUBLIC_BRAND_LEGAL_URL=""
NEXT_PUBLIC_BRAND_CITY="London"
NEXT_PUBLIC_BRAND_COUNTRY="GB"
# Defaults for GB: "the laws of England and Wales" / "the courts of England and Wales".
# NEXT_PUBLIC_BRAND_GOVERNING_LAW=""
# NEXT_PUBLIC_BRAND_COURTS=""
# No Hey Orders listing on Google Play yet: no store button.
NEXT_PUBLIC_BRAND_ANDROID_APP_URL=""

# --- What the site covers -------------------------------------------------------
NEXT_PUBLIC_LOCALES="en"
# Backend PLATFORM_BUSINESS_TYPES on the Hey Orders server.
NEXT_PUBLIC_BUSINESS_TYPES="restaurant"
# TajirPoint's own story and reseller programme; Hey Orders writes its own.
NEXT_PUBLIC_HIDDEN_PAGES="/about,/partners"

# --- Tracking (optional; Hey Orders' own IDs only) ------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GTM_ID=""

# --- Build script only (not read by the site) -----------------------------------
# Folder holding the files named above. Relative paths are from this repo's root.
BRAND_ASSETS_DIR="../documents/heyorders-brand"
